# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build
/dist/
/release/

# misc
.DS_Store
*.pem

# signing credentials (public certificate identity still ships in signed apps)
*.p12
*.pfx
*.p8
*.key
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
*.keystore
*.jks
/.secrets/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
